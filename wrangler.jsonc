{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omm-domovina-ai",
  // Vlastiti ulaz: Astro fetch + email() za račune poslane mailom.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // D.O.M. račun — isti kao podcast.domovina.ai i glazba.domovina.ai.
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
  // Samo omm.domovina.ai: API ni stranice ne smiju biti i na *.workers.dev ili
  // preview adresama, drugom originu bez istih pravila (audit, „Za provjeru“).
  "workers_dev": false,
  "preview_urls": false,

  "assets": { "directory": "./dist", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omm-domovina-ai",
      "database_id": "c0031a54-6fea-4e69-9b60-d37f68d801a5",
      "migrations_dir": "./migrations"
    }
  ],
  // Slike brojila, ključ <uređaj>/<id>.jpg. Čuvamo ih da se OCR može provjeriti.
  // Nova slika je pod tmp/<uređaj>/ dok ne uđe u snimak; lifecycle pravilo „tmp“
  // (wrangler r2 bucket lifecycle) briše tmp/ nakon dana.
  "r2_buckets": [{ "binding": "SLIKE", "bucket_name": "omm-domovina-ai-slike" }],
  "ai": { "binding": "AI" },
  // Browser Rendering: PDF izvještaja iz HTML stranice (src/pages/api/izvjestaj).
  "browser": { "binding": "BROWSER" },

  // Ograničenje brzine za /api/* (src/middleware.ts, SEC-02). Brojač je po lokaciji
  // Cloudflarea i približan, dovoljan protiv petlje skripte. Prvi uvoz s Hepija
  // pošalje i do 40 PDF-ova računa, pa je opći limit širok.
  "ratelimits": [
    { "name": "LIMIT_API", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } },
    // OCR (Workers AI) i PDF izvještaja (Browser Rendering): po IP-u i po ključu.
    { "name": "LIMIT_SKUPO", "namespace_id": "7102", "simple": { "limit": 10, "period": 60 } }
  ],
  // PDF računa parsira unpdf na CPU-u; bez ovoga zahtjev smije trošiti 30 s.
  "limits": { "cpu_ms": 10000 },

  "vars": {
    // Vision model za čitanje zaslona brojila. Usporedba 2026-10-12 na slici
    // Iskra MT171: llama-4-scout točno za 2 s (oznaku registra zna izmisliti),
    // kimi-k2.6 točno za 30 s, gemma-4 prazan odgovor, mistral-small greška.
    "OCR_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // Dodatni modeli koje `model` u /api/ocitaj smije tražiti (zarezom; za usporedbu).
    // Prazno: samo OCR_MODEL, jer bi inače svatko birao najskuplji model (SEC-02).
    "OCR_MODELI": "",
    // /admin (docs/admin.md): Cloudflare Access na /admin/sso ili passkey.
    // ADMIN_EMAILS se provjerava pri svakom zahtjevu; micanje iz popisa odmah gasi sesije.
    "ADMIN_EMAILS": "stepanic.matija@gmail.com,ms@ff.hr",
    "ADMIN_HOST": "omm.domovina.ai",
    "ACCESS_TEAM_DOMAIN": "domovina.cloudflareaccess.com",
    // AUD Access aplikacije „OMM admin (sso)“ koja štiti omm.domovina.ai/admin/sso.
    "ACCESS_AUD": "4f2cae64004e536c0f5d2bc669ac9c3852e96b9ec99481c03c87b28a6bc9f929"
  },

  // Dnevno čišćenje dnevnika i mailova (src/lib/ciscenje.ts, SEC-03).
  "triggers": { "crons": ["17 3 * * *"] },

  "routes": [{ "pattern": "omm.domovina.ai", "custom_domain": true }],
  // Bez invocation logova: bilježe URL zahtjeva, a stare oznake nose ključ u ?k= (SEC-04).
  // console.log/error i dalje stižu u Workers Logs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
