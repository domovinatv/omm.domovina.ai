---
// Most oznake „Uvezi iz HEP-a“ kad HEP-ov CSP ne pusti ni <script src> ni fetch
// prema nama (Moj račun: connect-src 'self', od 2026-10-22). Oznaka ovu stranicu
// ubaci kao skriveni iframe (?v=3); ona pročita /hep-uvoz.js i pošalje ga HEP-ovoj
// stranici preko postMessage, gdje ga oznaka izvrši kroz eval ili, gdje CSP ne
// dopušta eval (Moj račun od 2026-10-30), kao inline <script>. Zatim prima zahtjeve
// ({omm: "zahtjev", id, put, metoda, tip, kljuc, tijelo}) za /api/snimak i /api/racun
// (PDF računa s Hepija) i šalje ih s našeg origina.
// Iframe, a ne popup: Moj račun od 2026-10-30 šalje COOP same-origin, pa popup
// nema opener. Middleware ovoj stranici dopušta frame-ancestors HEP-ovih portala.
// Starije oznake je otvaraju kao popup (window.opener); bez openera traže novu oznaku.
// Kod je javan, a ključ dolazi iz oznake, pa ovdje nema ničeg tajnog.
import Ikone from "../components/Ikone.astro";
import Tema from "../components/Tema.astro";
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>OMM · Oznaka</title>
    <Ikone />
    <Tema />
    <style is:global>
      body { margin: 0; background: var(--bg); color: var(--tekst);
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
      main { padding: 24px 16px; }
      .greska { color: var(--greska); }
    </style>
  </head>
  <body>
    <main><p id="stanje">Učitavam uvoz za HEP-ovu karticu…</p></main>
    <script>
      const HEP = ["https://mojamreza.hep.hr", "https://mojracun.hep.hr"];
      const stanje = document.getElementById("stanje")!;
      const greska = (t: string) => { stanje.textContent = t; stanje.className = "greska"; };
      const PUTOVI = ["/api/snimak", "/api/racun"];
      const iframe = window.parent !== window;
      const hep = iframe ? window.parent : window.opener;

      if (!hep) {
        stanje.className = "greska";
        stanje.innerHTML = 'Ova kartica služi oznaci „Uvezi iz HEP-a“. Ako si je otvorio klikom na oznaku, oznaka je zastarjela (HEP je pooštrio zaštitu): otvori <a href="/" target="_blank">omm.domovina.ai</a>, obriši staru oznaku i povuci novu.';
      } else {
        if (iframe) {
          window.addEventListener("message", async (e) => {
            if (!HEP.includes(e.origin) || e.source !== window.parent || e.data?.omm !== "zahtjev") return;
            const { id, put, metoda, tip, kljuc, tijelo } = e.data;
            let status = 0, j: unknown = {};
            try {
              if (!PUTOVI.includes(put) || !["GET", "POST"].includes(metoda)) throw new Error(`nedopušten zahtjev ${metoda} ${put}`);
              const headers: Record<string, string> = { Authorization: `Bearer ${kljuc}` };
              if (tip) headers["Content-Type"] = tip;
              const r = await fetch(put, { method: metoda, headers, body: metoda === "GET" ? undefined : tijelo });
              status = r.status;
              j = await r.json().catch(() => ({}));
            } catch (x) {
              j = { greska: (x as Error).message || String(x) };
            }
            window.parent.postMessage({ omm: "odgovor", id, status, j }, e.origin);
          });
        }
        fetch(`/hep-uvoz.js?v=${Date.now()}`)
          .then((r) => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.text(); })
          .then((kod) => {
            // Poruka stigne samo onom od ovih origina koji je stvarno otvorio karticu.
            for (const o of HEP) hep.postMessage({ omm: "kod", kod }, o);
            if (iframe) return;
            if (new URLSearchParams(location.search).get("v") === "2") {
              stanje.textContent = "Gotovo, vrati se na HEP-ovu karticu.";
              setTimeout(() => window.close(), 300);
            } else {
              stanje.innerHTML = 'Ako se na HEP-ovoj kartici ne pojavi stupac, tvoja oznaka je zastarjela (HEP je pooštrio zaštitu). Otvori <a href="/" target="_blank">omm.domovina.ai</a>, obriši staru oznaku ⚡ Uvezi iz HEP-a i povuci novu.';
            }
          })
          .catch((e) => greska(`Ne mogu učitati uvoz (${e.message || e}).`));
      }
    </script>
  </body>
</html>
