---
import AdminOkvir from "../../../components/AdminOkvir.astro";
import { IZVORI, kad, pregledOmm, uredaji } from "../../../lib/admin/pregled";
import { poveznicaUpita } from "../../../lib/prikljucak";
import { popisPrikljucaka } from "../../../lib/prikljucci";

if (!Astro.locals.admin) return new Response(null, { status: 401 });

const omm = Astro.params.omm ?? "";
const o = /^\d{10}$/.test(omm) ? (await pregledOmm()).find((x) => x.omm === omm) : undefined;
if (!o) return new Response("Nema tog OMM-a", { status: 404 });
const dnevnik = await uredaji(o.korisnici.map((k) => k.uredaj));
const izv = `/admin/izvjestaj/${omm}`;
const k1 = encodeURIComponent(o.korisnici[0]?.uredaj ?? "");
// Priključna snaga po ključu: spremljena ili upit Elektri s podacima iz uvoza tog ključa.
const prikljucci = await Promise.all(o.korisnici.map(async (k) => {
  const p = (await popisPrikljucaka(k.uredaj)).find((x) => x.omm === omm) ?? { omm, elektra: null, prikljucak: null };
  return { uredaj: k.uredaj, p, upit: poveznicaUpita(p), proslijedi: `racuni+${k.uredaj}@omm.domovina.ai` };
}));
const kw = (n: number) => n.toLocaleString("hr-HR", { maximumFractionDigits: 2 });
const preglednik = (ua: string | null) =>
  !ua ? "—" : /iPhone|iPad/.test(ua) ? "iOS" : /Android/.test(ua) ? "Android" : /Mac OS/.test(ua) ? "macOS" : /Windows/.test(ua) ? "Windows" : ua.slice(0, 40);
---
<AdminOkvir naslov={omm} siroko uzivo>
  <p><a href="/admin"><i class="i i-arrow_back" aria-hidden="true"></i> Pregled</a></p>
  <h1 class="mono" style="font-size:1.5rem">{omm}</h1>
  <p>{o.adresa ?? "—"}{o.ime && <span class="blijedo"> · {o.ime}</span>}</p>
  <p>{o.izvori.map((i) => <span class="oznaka">{IZVORI[i] ?? i}</span>)}</p>
  {o.neslaganje && (
    <p><span class="oznaka upozorenje">ne slažu se</span> Ključevi navode različitu adresu ili ime. Uvoz šalje
      korisnik, pa je netko ovaj OMM možda upisao kao svoj; izvještaj radi po ključu.</p>
  )}

  <div class="kartica">
    <h2 style="margin-top:0">Izvještaj</h2>
    {o.uvoza === 0 ? <p class="blijedo">Nema uvoza s HEP-a, pa nema ni izvještaja (samo očitanja ili računi mailom).</p>
      : o.korisnici.length === 1 ? (
        <div class="akcije">
          <a class="gumb glavni" href={`${izv}?kljuc=${k1}`}>PDF</a>
          <a class="gumb" href={`${izv}?kljuc=${k1}&oblik=html`} target="_blank">HTML</a>
          <a class="gumb" href={`${izv}?kljuc=${k1}&anonimno=1`}>Anonimni PDF</a>
          <a class="gumb" href={`${izv}?kljuc=${k1}&oblik=json`} target="_blank">JSON</a>
        </div>
      ) : (
        <>
          <p class="blijedo">Podatke za ovaj OMM šalje više ključeva ({o.korisnici.length}). Izvještaj po ključu je u
            tablici ispod; spojeni miješa njihova očitanja, pa ga koristi samo kad znaš da su svi ključevi iste osobe.</p>
          <div class="akcije">
            <a class="gumb" href={`${izv}?svi=1`}>Spojeni PDF</a>
            <a class="gumb" href={`${izv}?svi=1&oblik=html`} target="_blank">Spojeni HTML</a>
          </div>
        </>
      )}
  </div>

  <div class="kartica">
    <h2 style="margin-top:0">Priključna snaga</h2>
    {prikljucci.map(({ uredaj, p, upit, proslijedi }) => (
      <div style="margin-bottom:12px">
        {prikljucci.length > 1 && <p class="mono blijedo" title={uredaj}>{uredaj}</p>}
        {p.prikljucak ? (
          <p><strong>{kw(p.prikljucak.snaga_kw)} kW</strong>
            {p.prikljucak.faze && ` · ${p.prikljucak.faze === 3 ? "trofazni" : "jednofazni"}`}
            {p.prikljucak.osigurac_a && ` · ${p.prikljucak.faze ?? 1}×${p.prikljucak.osigurac_a} A`}
            <span class="blijedo"> · {p.prikljucak.izvor === "mail" ? "iz odgovora HEP-a" : "upisano ručno"}, {kad(p.prikljucak.azuriran)}</span></p>
        ) : <p class="blijedo">Nije poznata.</p>}
        <div class="akcije">
          <a class={p.prikljucak ? "gumb" : "gumb glavni"} href={upit.gmail} target="_blank" rel="noopener"><i class="i i-mail" aria-hidden="true"></i> Pošalji u Gmailu</a>
          <a class="gumb" href={upit.mailto} target="_blank" rel="noopener"><i class="i i-mail" aria-hidden="true"></i> Drugi mail program</a>
        </div>
        <p class="blijedo" style="margin-bottom:0">Prima {upit.kome.naziv} ({upit.kome.email}). HEP podatak daje kupcu, pa je upit
          potpisan imenom iz uvoza. Odgovor proslijedi na <code class="mono" style="user-select:all">{proslijedi}</code></p>
      </div>
    ))}
  </div>

  <h2>Korisnici ({o.korisnici.length})</h2>
  <div class="tablica">
    <table>
      <thead>
        <tr><th>Ključ</th><th>Adresa / kupac</th><th>Izvori</th><th>Uvoza</th><th>Očitanja</th><th>Prvi</th><th>Zadnji</th><th>Uređaj</th><th>Izvještaj</th></tr>
      </thead>
      <tbody>
        {o.korisnici.map((k) => {
          const d = dnevnik.get(k.uredaj);
          return (
            <tr>
              <td class="mono" title={k.uredaj}>{k.uredaj}</td>
              <td>{k.adresa ?? "—"}<br /><span class="blijedo">{k.ime ?? ""}</span></td>
              <td>{k.izvori.map((i) => <span class="oznaka">{IZVORI[i] ?? i}</span>)}</td>
              <td class="broj">{k.uvoza}</td>
              <td class="broj">{k.ocitanja}{k.racuna ? ` + ${k.racuna} rač.` : ""}</td>
              <td style="white-space:nowrap">{kad(k.prvi)}</td>
              <td style="white-space:nowrap">{kad(k.zadnji)}</td>
              <td title={d?.user_agent ?? ""}>{preglednik(d?.user_agent ?? null)}{d?.drzava ? ` · ${d.drzava}` : ""}</td>
              <td>
                {k.uvoza > 0 ? (
                  <div class="akcije">
                    <a class="gumb mali" href={`${izv}?kljuc=${encodeURIComponent(k.uredaj)}`}>PDF</a>
                    <a class="gumb mali" href={`${izv}?kljuc=${encodeURIComponent(k.uredaj)}&oblik=html`} target="_blank">HTML</a>
                  </div>
                ) : <span class="blijedo">—</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</AdminOkvir>
