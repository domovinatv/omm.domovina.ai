---
// Naslovnica: uvoz s HEP-a oznakom (bookmarklet). To je jedini način uvoza koji
// nudimo korisnicima: ništa se ne instalira, prijava ostaje na HEP-u.
// Kod oznake je public/hep-uvoz.js, generiran iz flutter_moja_mreza/extension.
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Uvoz s HEP-a</title>
    <meta name="description" content="Očitanja, potrošnja i računi s Moje mreže, Mojeg računa i Hepija u dva klika, bez instaliranja ičega." />
    <style is:global>
      :root {
        --bg: #f6f7f4; --kartica: #fff; --tekst: #1b1f1a; --blijedo: #5d665b;
        --rub: #dfe3db; --akcent: #1f7a3a; --akcent-tekst: #fff; --akcent-blago: #e3f1e6; --greska: #b3261e;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #121512; --kartica: #1b1f1b; --tekst: #e7ebe4; --blijedo: #9ba697; --rub: #2e352d;
          --akcent: #5cc97a; --akcent-tekst: #0b1a0f; --akcent-blago: #1d3324; --greska: #ff8a80; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--tekst);
        font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
      main { max-width: 640px; margin: 0 auto; padding: 32px 16px 64px; }
      a { color: var(--akcent); }
      h1 { font-size: 1.8rem; line-height: 1.2; margin: 0 0 8px; }
      h2 { font-size: 1.1rem; margin: 0 0 8px; }
      p { margin: 8px 0; }
      .uvod { color: var(--blijedo); margin: 0 0 24px; }
      .kartica { background: var(--kartica); border: 1px solid var(--rub); border-radius: 16px; padding: 18px; margin-bottom: 14px; }
      .korak { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
      .broj { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 700;
        background: var(--akcent-blago); color: var(--akcent); }
      .oznaka-red { text-align: center; padding: 14px 0 4px; }
      .oznaka { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 999px;
        background: var(--akcent); color: var(--akcent-tekst); font-weight: 700; font-size: 1.05rem; text-decoration: none;
        cursor: grab; box-shadow: 0 2px 10px rgba(31,122,58,.25); }
      .oznaka:active { cursor: grabbing; }
      .portali { display: grid; gap: 8px; margin-top: 10px; }
      .portal { display: block; padding: 10px 14px; border: 1px solid var(--rub); border-radius: 12px; text-decoration: none; color: var(--tekst); }
      .portal b { display: block; } .portal span { font-size: .85rem; color: var(--blijedo); }
      .portal:hover { border-color: var(--akcent); }
      button { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 44px;
        border: 1px solid var(--rub); border-radius: 12px; font: inherit; font-weight: 600; cursor: pointer;
        background: transparent; color: var(--tekst); margin-top: 8px; }
      .stanje { font-size: .9rem; color: var(--blijedo); min-height: 1.4em; margin-top: 6px; text-align: center; }
      .stanje.greska { color: var(--greska); }
      .blijedo { color: var(--blijedo); font-size: .9rem; }
      kbd { font: .85em ui-monospace, monospace; border: 1px solid var(--rub); border-radius: 4px; padding: 1px 5px; }
      details { margin-top: 10px; } summary { cursor: pointer; font-weight: 600; }
      ol { padding-left: 22px; margin: 8px 0; } ol li { margin: 6px 0; }
      ul.snimci { list-style: none; padding: 0; margin: 0; }
      ul.snimci li { padding: 10px 0; border-top: 1px solid var(--rub); }
      ul.snimci li:first-child { border-top: 0; }
      ul.snimci .naslov { font-weight: 600; }
      ul.snimci .meta { font-size: .85rem; color: var(--blijedo); }
      footer { margin-top: 24px; font-size: .85rem; color: var(--blijedo); text-align: center; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <main>
      <h1>Tvoji podaci s HEP-a, u dva klika</h1>
      <p class="uvod">Očitanja, potrošnja i računi s <b>Moje mreže</b>, <b>Mojeg računa</b> i <b>Hepija</b>.
        Ništa ne instaliraš, a lozinku upisuješ samo HEP-u.</p>

      <section class="kartica" id="primi" hidden>
        <h2>Primam uvoz…</h2>
        <div class="stanje" id="stanje-primi">Čekam podatke s HEP-ove kartice.</div>
      </section>

      <section class="kartica korak">
        <div class="broj">1</div>
        <div>
          <h2>Povuci gumb u traku s oznakama</h2>
          <p class="blijedo" id="traka">Ako traku ne vidiš: <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>B</kbd> (na Macu <kbd>⌘</kbd>+<kbd>Shift</kbd>+<kbd>B</kbd>). Ovo radiš samo jednom.</p>
          <div class="oznaka-red">
            <a class="oznaka" id="oznaka" href="#" title="Povuci me u traku s oznakama">⚡ Uvezi iz HEP-a</a>
          </div>
          <div class="stanje" id="stanje-oznaka"></div>
          <details id="mobitel">
            <summary>Na mobitelu</summary>
            <ol>
              <li><button id="kopiraj" type="button">Kopiraj kod oznake</button></li>
              <li>Dodaj ovu stranicu u oznake, uredi tu oznaku, nazovi je <b>Uvezi iz HEP-a</b> i umjesto adrese zalijepi kod.</li>
              <li>Na prijavljenom portalu: u Chromeu upiši <i>Uvezi iz HEP-a</i> u adresnu traku i odaberi oznaku;
                u Safariju otvori Oznake i dodirni je.</li>
            </ol>
          </details>
        </div>
      </section>

      <section class="kartica korak">
        <div class="broj">2</div>
        <div>
          <h2>Prijavi se na HEP kao inače</h2>
          <div class="portali">
            <a class="portal" href="https://mojamreza.hep.hr/" target="_blank" rel="noopener">
              <b>Moja mreža</b><span>HEP ODS · očitanja brojila i potrošnja · prijava e-Građanima</span></a>
            <a class="portal" href="https://mojracun.hep.hr/hepi/" target="_blank" rel="noopener">
              <b>Moj Hepi račun</b><span>HEP Opskrba · računi s PDF-om, uplate, potrošnja</span></a>
            <a class="portal" href="https://mojracun.hep.hr/elektra/" target="_blank" rel="noopener">
              <b>Moj račun</b><span>HEP Elektra · računi, uplate, potrošnja</span></a>
          </div>
        </div>
      </section>

      <section class="kartica korak">
        <div class="broj">3</div>
        <div>
          <h2>Klikni oznaku, pa „Uvezi“</h2>
          <p class="blijedo">Na HEP-ovoj stranici pojavi se prozorčić koji kaže što će pročitati. Nakon klika na <b>Uvezi</b> podaci stižu ovamo. Za više portala ponovi korake 2 i 3.</p>
        </div>
      </section>

      <section class="kartica">
        <h2>Moji uvozi</h2>
        <ul class="snimci" id="snimci"><li class="meta">Još nema uvoza.</li></ul>
      </section>

      <section class="kartica">
        <details>
          <summary>Kako to radi i zašto je sigurno</summary>
          <p class="blijedo">Oznaka na HEP-ovu stranicu na kojoj si prijavljen učita našu skriptu. Ona čita iste stranice koje i ti
            vidiš, a gotov sažetak šalje ovamo tek kad klikneš <b>Uvezi</b>. Ne čita OIB ni lozinku, ne šalje kolačiće ni
            token prijave, i nestane kad zatvoriš stranicu. PDF računa pročitamo i ne čuvamo.</p>
          <p class="blijedo">Svaki zahtjev je popisan u
            <a href="https://github.com/stepanic/flutter_moja_mreza/blob/main/docs/kako-citamo-podatke.md" target="_blank" rel="noopener">kako čitamo podatke</a>,
            a kod koji se izvršava vidiš na <a href="/hep-uvoz.js" target="_blank">/hep-uvoz.js</a>.</p>
          <p class="blijedo">Oznaka sadrži ključ ovog preglednika: tko ga ima, vidi tvoje uvoze. Ne dijeli je.</p>
        </details>
      </section>

      <footer>Rana verzija bez prijave: uvozi su vezani uz ovaj preglednik. · <a href="/ocitaj">Očitaj brojilo sa slike</a></footer>
    </main>

    <script>
      import { kljuc } from "../lib/kljuc-klijent";
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const k = kljuc();
      const auth = { Authorization: `Bearer ${k}` };
      const HEP = ["https://mojamreza.hep.hr", "https://mojracun.hep.hr"];

      // Mali loader; sav kod je u /hep-uvoz.js da se parser može popraviti bez
      // ponovnog povlačenja oznake. ?v= zaobilazi predmemoriju.
      const kod = `javascript:(()=>{var s=document.createElement('script');s.src='${location.origin}/hep-uvoz.js?k=${k}&v='+Date.now();document.body.appendChild(s)})()`;
      const oznaka = $<HTMLAnchorElement>("oznaka");
      oznaka.href = kod;
      oznaka.onclick = (e) => {
        e.preventDefault();
        const s = $("stanje-oznaka");
        s.textContent = "Ne klikaj ovdje: povuci gumb u traku s oznakama, pa ga klikni na HEP-ovoj stranici.";
        s.className = "stanje greska";
      };
      $("kopiraj").onclick = async () => {
        await navigator.clipboard.writeText(kod);
        $("kopiraj").textContent = "Kopirano ✓";
      };
      // Na dodirnom zaslonu nema povlačenja: upute za mobitel su odmah otvorene.
      if (matchMedia("(pointer: coarse)").matches) {
        $<HTMLDetailsElement>("mobitel").open = true;
        $("traka").textContent = "Na mobitelu oznaku dodaješ ručno, jednom:";
      }

      const NAZIVI: Record<string, string> = {
        hep: "Moja mreža (HEP ODS)",
        "hep-hepi": "Moj Hepi račun (HEP Opskrba)",
        "hep-moj-racun": "Moj račun (HEP Elektra)",
      };
      type Snimak = { izvor: string; stvoren: string; omm: string | null };
      const vrijeme = (s: string) => new Date(s).toLocaleString("hr-HR");

      async function ucitaj() {
        const r = await fetch("/api/snimak", { headers: auth });
        if (!r.ok) return;
        const lista = (await r.json()) as Snimak[];
        const uvozi = lista.filter((s) => s.izvor in NAZIVI);
        const racuni = lista.filter((s) => s.izvor === "hep-racun");
        if (!uvozi.length && !racuni.length) return;
        const ul = $("snimci");
        ul.replaceChildren();
        const redak = (naslov: string, meta: string) => {
          const li = document.createElement("li");
          const n = document.createElement("div"); n.className = "naslov"; n.textContent = naslov;
          const m = document.createElement("div"); m.className = "meta"; m.textContent = meta;
          li.append(n, m); ul.append(li);
        };
        for (const s of uvozi) redak(NAZIVI[s.izvor], [vrijeme(s.stvoren), s.omm && `OMM ${s.omm}`].filter(Boolean).join(" · "));
        // Pročitani PDF-ovi računa su jedan redak, ne dvadeset.
        if (racuni.length) redak(`Pročitani računi: ${racuni.length}`, `zadnji stigao ${vrijeme(racuni[0].stvoren)}`);
      }
      ucitaj();
      // Povratak s HEP-ove kartice osvježi popis.
      document.addEventListener("visibilitychange", () => { if (!document.hidden) ucitaj(); });

      // Rezerva kad HEP ne pusti izravan fetch: oznaka otvori /?primi=1 i pošalje
      // tijelo snimka preko postMessage. Prima se samo s HEP-ovih portala.
      if (new URLSearchParams(location.search).has("primi") && window.opener) {
        $("primi").hidden = false;
        const stanje = $("stanje-primi");
        window.addEventListener("message", async (e) => {
          if (!HEP.includes(e.origin) || e.source !== window.opener || e.data?.omm !== "uvoz") return;
          stanje.textContent = "Spremam…";
          const r = await fetch("/api/snimak", {
            method: "POST",
            headers: { ...auth, "Content-Type": "application/json" },
            body: JSON.stringify(e.data.tijelo),
          });
          const d = await r.json().catch(() => ({}));
          stanje.textContent = r.ok ? (d.duplikat ? "Isti uvoz je već bio ovdje ✓" : "Spremljeno ✓") : (d.greska ?? `Greška ${r.status}`);
          stanje.className = r.ok ? "stanje" : "stanje greska";
          ucitaj();
        });
        for (const o of HEP) window.opener.postMessage({ omm: "spreman" }, o);
      }
    </script>
  </body>
</html>
