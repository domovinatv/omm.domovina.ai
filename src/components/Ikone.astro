---
// Favicon i ikona za početni zaslon. `?znak=a` prikazuje opciju A (D okvir) umjesto pločice,
// dok se ne odluči koja ostaje (2026-10-15).
const a = Astro.url.searchParams.get("znak") === "a";
---
<link rel="icon" type="image/svg+xml" href={a ? "/a/favicon.svg" : "/favicon.svg"} />
<link rel="icon" type="image/png" sizes="32x32" href={a ? "/a/favicon-32.png" : "/favicon-32.png"} />
<link rel="apple-touch-icon" href={a ? "/a/apple-touch-icon.png" : "/apple-touch-icon.png"} />
<link rel="stylesheet" href="/ikone/ikone.css" />
