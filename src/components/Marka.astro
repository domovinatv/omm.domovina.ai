---
// Znak + ime u zaglavlju. Svijetla stranica nosi logo.svg, tamna logo-noc.svg (prema temi, ne
// samo prema sustavu, jer temu mijenja i PrekidacTeme).
import { znakA } from "../lib/znak";
interface Props { dodatak?: string }
const { dodatak } = Astro.props;
const a = znakA(Astro.url);
const p = a ? "/a" : "";
---
<a class="marka" href={a ? "/?znak=a" : "/"}>
  <img class="samo-dan" src={`${p}/logo.svg`} width="32" height="32" alt="" />
  <img class="samo-noc" src={`${p}/logo-noc.svg`} width="32" height="32" alt="" />
  <span><b>OMM</b>{dodatak && <span class="marka-dodatak"> {dodatak}</span>}</span>
</a>
<style is:global>
  .marka { display: inline-flex; align-items: center; gap: 10px; color: var(--tekst); text-decoration: none;
    font-size: 1.05rem; letter-spacing: .02em; }
  .marka:hover { text-decoration: none; }
  .marka img { width: 32px; height: 32px; }
  .marka b { font-weight: 800; }
  .marka-dodatak { color: var(--blijedo); font-weight: 500; }
</style>
